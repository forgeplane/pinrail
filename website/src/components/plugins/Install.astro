---
// How to install a plugin, both ways: the line to give your agent, and the
// commands to run yourself, each with a button that copies it.
import { agentLine, commands, type Plugin } from "./plugins";

interface Props {
  plugin: Plugin;
}
const { plugin } = Astro.props;
const run = commands(plugin).join("\n");
---

<div class="plugin-install">
  <div class="plugin-install-way">
    <h3>Tell your agent</h3>
    <div class="plugin-copy">
      <code>{agentLine(plugin)}</code>
      <button type="button" class="plugin-copy-button" data-copy={agentLine(plugin)}>Copy</button>
    </div>
  </div>
  <div class="plugin-install-way">
    <h3>Or run it yourself</h3>
    <div class="plugin-copy">
      <pre><code>{run}</code></pre>
      <button type="button" class="plugin-copy-button" data-copy={run}>Copy</button>
    </div>
    {
      plugin.official ? (
        <p>
          The plugin comes with the app, so it installs by name.
          {plugin.recommended ? " The setup installs it, so it may be installed already." : ""} You can also install it in{" "}
          <em>Settings › Plugins</em>.
        </p>
      ) : (
        <p>
          The plugin is a sample in <a href="https://github.com/forgeplane/pinrail-plugins">forgeplane/pinrail-plugins</a>,
          and installs from a checkout of it.
          {plugin.build ? " Its view bundles libraries, so it is built first." : ""}
        </p>
      )
    }
  </div>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".plugin-copy-button")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>
