---
import "../../styles/views-carousel.css";
import Zoom from "./Zoom.astro";
import type { ImageMetadata } from "astro";

// The views in one carousel: the heading row (the slot, beside the arrows
// and the count), a track of slides, and a progress bar to jump with. The
// page puts it in an element marked data-carousels, which scopes the script.
interface Props {
  items: { name: string; plugin: string; detail: string; alt: string; image: ImageMetadata }[];
}
const { items } = Astro.props;
---
<div class="c-carousel-head">
  <slot />
  <div class="c-carousel-nav" aria-hidden="true">
    <span class="c-count"><b data-carousel-at>1</b> / <span>{items.length}</span></span>
    <button type="button" class="c-arrow" data-carousel-step="-1" tabindex="-1">←</button>
    <button type="button" class="c-arrow" data-carousel-step="1" tabindex="-1">→</button>
  </div>
</div>
<div class="c-carousel" data-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Views: scroll sideways for more">
  {items.map((v, i) => (
    <figure class:list={["c-slide", { "is-active": i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} of ${items.length}: ${v.name}`}>
      <Zoom src={v.image} alt={v.alt} caption={`${v.name}: ${v.detail}`} sizes="(max-width: 800px) 90vw, 960px" />
      <figcaption><span class="plugin">{v.plugin}</span><b>{v.name}</b>{v.detail}</figcaption>
    </figure>
  ))}
</div>
<div class="c-progress" role="group" aria-label="Go to a view">
  {items.map((v, i) => (
    <button type="button" data-carousel-go={i} aria-label={v.name} aria-current={i === 0 ? "true" : undefined}><span>{v.name}</span></button>
  ))}
</div>

<script>
  // The views, in one carousel. Sideways scrolling (a trackpad, touch,
  // shift and the wheel, or the arrow keys on the focused track) snaps
  // slide by slide, and the arrows, the count and the progress bar follow.
  const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const section of document.querySelectorAll<HTMLElement>("[data-carousels]")) {
    const at = section.querySelector("[data-carousel-at]")!;
    const arrows = [...section.querySelectorAll<HTMLButtonElement>("[data-carousel-step]")];
    const track = section.querySelector<HTMLElement>("[data-carousel]")!;
    const slides = [...track.querySelectorAll<HTMLElement>(".c-slide")];
    const marks = [...section.querySelectorAll<HTMLButtonElement>("[data-carousel-go]")];
    const pad = () => parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
    let current = -1;
    const go = (i: number) => {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: slide.offsetLeft - pad(), behavior: smooth ? "smooth" : "auto" });
    };
    const show = (i: number) => {
      if (i === current) return;
      current = i;
      slides.forEach((s, k) => s.classList.toggle("is-active", k === i));
      marks.forEach((m, k) => (k === i ? m.setAttribute("aria-current", "true") : m.removeAttribute("aria-current")));
      at.textContent = String(i + 1);
      arrows[0].disabled = i <= 0;
      arrows[1].disabled = i === slides.length - 1;
    };
    // the slide whose start is nearest the track's, or the last at the end
    const follow = () => {
      const x = track.scrollLeft + pad();
      let i = slides.reduce((best, s, k) => (Math.abs(s.offsetLeft - x) < Math.abs(slides[best].offsetLeft - x) ? k : best), 0);
      if (track.scrollLeft >= track.scrollWidth - track.clientWidth - 2) i = slides.length - 1;
      show(i);
    };
    let frame = 0;
    track.addEventListener("scroll", () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(follow); }, { passive: true });
    marks.forEach((m) => m.addEventListener("click", () => go(Number(m.dataset.carouselGo))));
    arrows.forEach((a) => a.addEventListener("click", () => go(current + Number(a.dataset.carouselStep))));
    // a slide peeking in comes forward on a click, rather than opening full size
    slides.forEach((s, k) => s.addEventListener("click", (e) => {
      if (k === current) return;
      e.preventDefault();
      e.stopPropagation();
      go(k);
    }, { capture: true }));
    show(0);
  }
</script>
