---
// A phrase that retypes itself through a list, as index6's headline does.
// The first word is the markup, so without script or with reduced motion the
// sentence still reads whole.
interface Props { words: string[] }
const { words } = Astro.props;
---
<span class="typed"><span data-words={JSON.stringify(words)}>{words[0]}</span><span class="typed-caret" aria-hidden="true"></span></span>

<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    for (const typed of document.querySelectorAll<HTMLElement>("[data-words]")) {
      const words: string[] = JSON.parse(typed.dataset.words ?? "[]");
      (async () => {
        await sleep(2600);
        for (let i = 1; ; i = (i + 1) % words.length) {
          const current = typed.textContent ?? "";
          for (let n = current.length - 1; n >= 0; n--) {
            typed.textContent = current.slice(0, n);
            await sleep(38);
          }
          await sleep(260);
          const next = words[i];
          for (let n = 1; n <= next.length; n++) {
            typed.textContent = next.slice(0, n);
            await sleep(n === next.length ? 0 : 58 + Math.random() * 40);
          }
          await sleep(2400);
        }
      })();
    }
  }
</script>
