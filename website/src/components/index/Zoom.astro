---
// A screenshot that opens full size. The thumbnail is a button; the full
// image loads only when asked for. With `dark`, the dark theme shows that
// one instead, in the page and full size.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { src: ImageMetadata; dark?: ImageMetadata; alt: string; caption: string; sizes: string; class?: string }
const { src, dark, alt, caption, sizes, class: cls } = Astro.props;
const large = (image: ImageMetadata) => getImage({ src: image, width: Math.min(image.width, 2400), format: "webp" });
const full = await large(src);
const fullDark = dark ? await large(dark) : undefined;
---
<button type="button" class:list={["zoom", cls]} data-zoom={full.src} data-zoom-dark={fullDark?.src} data-zoom-alt={alt} data-zoom-caption={caption} aria-label={`Enlarge: ${caption}`}>
  <Image src={src} alt={alt} widths={[480, 960, 1400]} sizes={sizes} class:list={[dark && "theme-light"]} />
  {dark && <Image src={dark} alt={alt} widths={[480, 960, 1400]} sizes={sizes} class="theme-dark" />}
  <span class="zoom-hint" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg></span>
</button>
