---
import { repo } from "./index/content";
// The landing pages' footer. `other` links to the other version of the
// landing page: the review page from the classic ones, and back.
interface Props { other: { href: string; label: string } }
const { other } = Astro.props;
---
<footer class="colophon">
  <span>Pinrail · a person in the loop of your agents.<small class="maker">By <a href="https://forgeplane.ai">Forgeplane</a> · <a href="https://x.com/forgeplane">@forgeplane</a> · <a href="mailto:hey@pinrail.dev">hey@pinrail.dev</a></small><small>No cookies: Cloudflare counts visits anonymously.</small><small>Product names and logos belong to their owners and are shown only to say which agents Pinrail works with. Pinrail is not affiliated with them or endorsed by them.</small></span>
  <nav><a href="/docs/">Docs</a><a href="/blog/">Blog</a><a href="/docs/building/writing/">Write a plugin</a><a href={repo}>GitHub</a><a href={other.href}>{other.label}</a></nav>
</footer>
