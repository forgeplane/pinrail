---
// Version 7, the usual way round: the same product and the same look as the
// page you review, laid out as a landing page for people who'd rather read.
import "../styles/index.css";
import "../styles/index-classic.css";
import Zoom from "../components/index/Zoom.astro";
import HeroDemo from "../components/index/HeroDemo.astro";
import HowItWorks from "../components/index/HowItWorks.astro";
import { icons } from "../components/index/lucide";
import Lightbox from "../components/index/Lightbox.astro";
import ModeSwitch from "../components/index/ModeSwitch.astro";
import Brand from "../components/Brand.astro";
import Download from "../components/Download.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Typed from "../components/index/Typed.astro";
import Faq from "../components/index/Faq.astro";
import { agents, downloadPage, repo, samples, views } from "../components/index/content";

// What agents would say, if they wrote testimonials. Imagined, and said so
// on the page; each is signed by the agent's workflow, not the product it runs on.
const voices = [
  {
    quote: "Three times this month I was about to post a review comment asking for a null check that was already there, two lines up. Maya rejected each one with a line of why. I read those lines before every review now, and my comments get posted as I wrote them.",
    agent: "pr-reviewer", role: "Code review, northwind/api", runs: "Claude Code", icon: "claude",
  },
  {
    quote: "I used to hear “the plane feels off” and redraw all four. Now I get a box around its nose, 87% across and 30% down, and “tilt it up towards the sun”. The box goes straight to the inpainting pass. Round two changed one region, not the picture.",
    agent: "illustrator", role: "Illustration, tern/web", runs: "Gemini CLI", icon: "gemini",
  },
  {
    quote: "Checkout was returning 502s and I had a redeploy of production ready to go. Before running it, I asked. The answer came back in a minute: it's the scheduled database maintenance, it ends at 03:00, leave it. I would have restarted every pod in the middle of a failover.",
    agent: "oncall", role: "Operations, northwind/infra", runs: "Codex", icon: "codex",
  },
  {
    quote: "Four voices read the intro. The notes came back pinned to the millisecond: “Nguyen” at 0:02.42 is one syllable, the bridge line is too fast, cut “This week”. I re-recorded two seconds instead of the take, and the cut landed exactly where it was marked.",
    agent: "voiceover", role: "Voice-over, fieldnotes/episodes", runs: "OpenCode", icon: "opencode",
  },
  {
    quote: "My cleanup found 1,284 inactive accounts and a query to delete them. The review came back discarded: legal hasn't signed off on the retention policy. Exit 5, reason attached. I stopped, and nothing was deleted that couldn't be undone.",
    agent: "data-retention", role: "Maintenance, northwind/api", runs: "Cursor", icon: "cursor",
  },
  {
    quote: "I sent four desk lamps as 3D models. The favourite came back with a comment on one part, by its name: Upper arm › Elbow, “a warmer brass”, and the angle it was seen from. I changed one material on one node. Nobody had to describe an elbow to me.",
    agent: "product-design", role: "3D models, halden/lamps", runs: "Kimi", icon: "kimi",
  },
];

const sets = [
  { label: "Before it acts", items: views },
  { label: "On what it makes", items: samples },
];

const codes = [
  ["0", "Decided. The decision is on stdout, and in --decision-out if given."],
  ["3", "Withdrawn by the agent, or expired, before anyone decided."],
  ["4", "--timeout ran out. The review is still pending."],
  ["5", "Discarded: stop the work this review was gating."],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Before your agent acts, it asks. Pinrail is a desktop inbox where agents wait for your decision on a diff, a batch of emails or a page, or for your feedback on what they make, and carry on with it." />
    <meta name="theme-color" content="#f5f0e6" />
    <meta property="og:title" content="Pinrail — before your agent acts, it asks" />
    <meta property="og:description" content="A desktop inbox for agent work. Decide it, or mark it up, in a view made for it; your answer goes straight back." />
    <title>Pinrail — before your agent acts, it asks</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist:wght@400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@500;700&display=swap" />
  </head>
  <body class="classic">
    <a href="#main" class="skip">Skip to content</a>

    <header class="topnav">
      <a class="brand" href="/" aria-label="Pinrail home"><Brand /></a>
      <nav class="links" aria-label="Main">
        <a href="#how">How it works</a><a href="#views">Views</a><a href="#cli">CLI</a><a href="#faq">FAQ</a><a href="/docs/">Docs</a><a href={repo}>GitHub ↗</a>
      </nav>
      <ModeSwitch current="classic" />
    </header>

    <main id="main">
      <section class="c-hero">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>The review inbox for agent work</p>
        <h1>Before your agent acts,<br /><em><Typed words={["it asks.", "you look.", "you decide.", "you edit.", "you say stop."]} /></em></h1>
        <p class="c-lede">Pinrail is a desktop inbox for the moments your agent needs you: review comments about to be posted, emails about to be sent, an illustration or a voice-over still taking shape. The agent submits its work, waits, and carries on with your decision, or comes back with the next round.</p>
        <div class="c-ctas">
          <Download />
          <a class="ghost big" href="/docs/getting-started/install/">Read the docs</a>
        </div>
        <p class="c-fine">Free and open source · macOS and Linux, Windows soon · <a href={downloadPage}>every download</a> · in early development</p>
        <div class="c-shot">
          <span class="hand shot-note left" aria-hidden="true">click a review<svg class="scribble" viewBox="0 0 64 50"><path d="M2 12c14-7 34-8 44 2 7 7 8 17 6 30" /><path d="M44 36l8 9 7-10" /></svg></span>
          <HeroDemo />
        </div>
      </section>

      <section class="c-agents" aria-label="Works with any agent">
        <p>Works with any agent that can run a command</p>
        <ul>{agents.map((a) => <li><img src={`/agents/${a.icon}.svg`} width="20" height="20" alt="" />{a.name}</li>)}<li class="c-agents-more"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons["bot"]} />yours</li></ul>
      </section>

      <section class="c-section" id="how">
        <div class="c-head">
          <p class="kicker">01 · How it works</p>
          <h2>One command in, <em>one decision out.</em></h2>
          <p>You tell the agent when to stop for you, in whatever instructions it follows. When it gets there, it asks through Pinrail and waits.</p>
        </div>
        <HowItWorks />
      </section>

      <section class="c-section" id="views" data-carousels>
        <div class="c-carousel-head">
          <div class="c-head">
            <p class="kicker">02 · Views</p>
            <h2>A diff deserves a diff. <em>A picture deserves a pen.</em></h2>
            <p>Each kind of request is a plugin, with a view made for deciding it: the diff for a code review, the draft itself for an email, the image for a picture, the waveform for a voice take. What you say goes back with what it points at, down to the line, the pixel or the millisecond.</p>
          </div>
          <div class="c-carousel-nav" aria-hidden="true">
            <span class="c-count"><b data-carousel-at>1</b> / <span data-carousel-total>{sets[0].items.length}</span></span>
            <button type="button" class="c-arrow" data-carousel-step="-1" tabindex="-1">←</button>
            <button type="button" class="c-arrow" data-carousel-step="1" tabindex="-1">→</button>
          </div>
        </div>
        <div class="c-switch" role="tablist" aria-label="Kinds of view">
          {sets.map((set, s) => (
            <button type="button" role="tab" id={`views-tab-${s}`} aria-controls={`views-set-${s}`} aria-selected={s === 0 ? "true" : "false"} data-carousel-set={s}>{set.label}<span>{set.items.length}</span></button>
          ))}
        </div>
        {sets.map((set, s) => (
          <div class="c-carousel-set" role="tabpanel" id={`views-set-${s}`} aria-labelledby={`views-tab-${s}`} data-set={s} hidden={s !== 0}>
            <div class="c-carousel" data-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label={`${set.label}: scroll sideways for more`}>
              {set.items.map((v, i) => (
                <figure class:list={["c-slide", { "is-active": i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} of ${set.items.length}: ${v.name}`}>
                  <Zoom src={v.image} alt={v.alt} caption={`${v.name}: ${v.detail}`} sizes="(max-width: 800px) 90vw, 960px" />
                  <figcaption><span class="plugin">{v.plugin}</span><b>{v.name}</b>{v.detail}</figcaption>
                </figure>
              ))}
            </div>
            <div class="c-progress" role="group" aria-label={`Go to a view: ${set.label}`}>
              {set.items.map((v, i) => (
                <button type="button" data-carousel-go={i} aria-label={v.name} aria-current={i === 0 ? "true" : undefined}><span>{v.name}</span></button>
              ))}
            </div>
          </div>
        ))}
        <div class="c-own">
          <code>pinrail plugins new my_plugin</code>
          <p><b>Ten views so far. The next one is yours.</b> A plugin is a manifest, two JSON schemas and a web page, built with any web framework you like, or none at all. Storyboards, floor plans, moodboards, a map with a no-go zone scribbled on it: if your agent can make it, you can put it in front of your eyes and mark it up. The only limits are your imagination and your agent's.</p>
          <a href="/docs/building/writing/">Write a plugin →</a>
        </div>
      </section>

      <section class="c-section c-split">
        <div>
          <p class="kicker">03 · Rounds</p>
          <h2>A no comes with a reason, <em>and the reason comes back.</em></h2>
          <p>Send something back and the agent answers with a new round, submitted with <code>--revises</code>. It lands beside your earlier verdicts and comments, so you see what changed and why, and a view can set the two rounds side by side to check each fix. Every round and every decision is kept, and can be opened again later.</p>
          <div class="round-demo" aria-hidden="true">
            <div class="rd-row old"><span class="rd-tag">R1</span><s>Retry failed payments automatically.</s><span class="rd-verdict">✕ “could charge twice”</span></div>
            <div class="rd-row"><span class="rd-tag new">R2</span>Retry failed payments with the idempotency key.<span class="rd-pending">awaiting you</span></div>
          </div>
        </div>
        <div>
          <p class="kicker">04 · Stop</p>
          <h2>“Stop” is <em>a real answer.</em></h2>
          <p>Discard a review with a reason and the waiting command exits 5. The agent stops the work the review was gating, reports why, and doesn't try again. Every ending has its code:</p>
          <table class="codes">
            <tbody>{codes.map(([c, t]) => <tr class={c === "5" ? "stop" : undefined}><td>{c}</td><td>{t}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="c-section c-cli" id="cli">
        <div class="c-head">
          <p class="kicker">05 · The CLI</p>
          <h2>For an agent, <em>and for a script.</em></h2>
          <p>An agent reads the decision as markdown. A script keeps the JSON and branches on the exit code, and <code>--decision-out</code> writes the decision to a file for a workflow that already reads one.</p>
        </div>
        <div class="terminal">
          <div class="term-bar"><span></span><span></span><span></span><b>agent — zsh</b></div>
          <pre><span class="t-dim"># submit the proposed comments and wait for a person</span>
<span class="t-cmd">$ pinrail submit review --title "Dedup tickets on save" \
    --origin repo=acme/api,workflow=pr-review,ref=42 \
    --data proposals.json --wait</span>
<span class="t-dim">pinrail: review r_01K5Q8 submitted; waiting for a decision</span>
r_01K5Q8 · decided · Dedup tickets on save
review · acme/api · pr-review · 42 · decided by maya at 2026-09-23 10:14

## Proposals

<span class="t-ok">- **#18 accepted** `lib/acme/tickets.ex:149` — reversing twice is a no-op (major)</span>
<span class="t-ok">- **#19 accepted** `priv/repo/add_hash.exs:6` — missing index on tickets.hash (minor)</span>
  > mention the COALESCE
<span class="t-no">- **#20 rejected** `lib/acme/tickets.ex:151` — prefer Enum.uniq_by/2 (nit)</span>
  > fine as it is
<span class="t-ok">- **#21 accepted** `test/acme/tickets_test.exs:40` — test for the empty list (minor)</span>
<span class="t-cmd">$ echo $?</span>
0</pre>
        </div>
      </section>

      <section class="c-section c-facts">
        <p class="kicker">06 · Yours</p>
        <h2>On your machine, <em>with your agents.</em></h2>
        <div class="c-fact-grid">
          <article><h3>Local</h3><p>The app runs its server on loopback. Reviews and decisions stay on your computer. No account.</p></article>
          <article><h3>Contained</h3><p>A plugin's view is sandboxed: it draws, talks to the app, and nothing else.</p></article>
          <article><h3>Interruptible</h3><p>A notification when a review lands, a count in the menu bar, and the window can close while the app keeps listening.</p></article>
          <article><h3>Any agent</h3><p>If it can run a command, it can ask through Pinrail. Its own instructions say when.</p></article>
        </div>
      </section>

      <section class="c-section c-voices" id="voices" aria-labelledby="voices-title">
        <div class="c-head">
          <p class="kicker">07 · From the other side</p>
          <h2 id="voices-title">What the agents <em>would say.</em></h2>
          <p>If agents wrote testimonials. Imagined, but every one is a thing Pinrail is there for: a mistake caught, or a change asked for exactly.</p>
        </div>
        <div class="voice-grid">
          {voices.map((v) => (
            <figure class="voice">
              <blockquote>{v.quote}</blockquote>
              <figcaption>
                <img src={`/agents/${v.icon}.svg`} width="28" height="28" alt="" />
                <span><b>{v.agent}</b><small>{v.role} · runs on {v.runs}</small></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="c-section c-faq" id="faq">
        <div class="c-head">
          <p class="kicker">08 · Questions</p>
          <h2>Before you <em>ask.</em></h2>
        </div>
        <div class="faq-list"><Faq /></div>
      </section>

      <section class="c-final">
        <p class="hand">your move</p>
        <h2 class="closing-title"><span class="line">Put <em><Typed words={["a pinrail", "a second look", "a red pen", "your judgment", "a person"]} /></em></span><br /><span class="line">in front of your agents.</span></h2>
        <p>macOS and Linux today, Windows soon. Free and open source, in early development.</p>
        <div class="c-ctas">
          <Download />
          <a class="ghost big on-dark" href={repo}><GitHubIcon />Star on GitHub</a>
        </div>
        <a class="try-review" href="/review">Or skip the reading: review this page instead →</a>
      </section>
    </main>

    <Lightbox />

    <script>
      // The views: a carousel for each kind, one showing at a time. Sideways
      // scrolling (a trackpad, touch, shift and the wheel, or the arrow keys
      // on the focused track) snaps slide by slide; the switch picks the kind,
      // and the arrows, the count and the progress bar follow the one showing.
      const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
      for (const section of document.querySelectorAll<HTMLElement>("[data-carousels]")) {
        const at = section.querySelector("[data-carousel-at]")!;
        const total = section.querySelector("[data-carousel-total]")!;
        const arrows = [...section.querySelectorAll<HTMLButtonElement>("[data-carousel-step]")];
        const switches = [...section.querySelectorAll<HTMLButtonElement>("[data-carousel-set]")];
        const panels = [...section.querySelectorAll<HTMLElement>("[data-set]")];
        let active = 0;

        const carousels = panels.map((panel, n) => {
          const track = panel.querySelector<HTMLElement>("[data-carousel]")!;
          const slides = [...track.querySelectorAll<HTMLElement>(".c-slide")];
          const marks = [...panel.querySelectorAll<HTMLButtonElement>("[data-carousel-go]")];
          const pad = () => parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
          const c = { current: -1, go: (_: number) => {}, count: () => {} };
          c.count = () => {
            if (n !== active) return;
            at.textContent = String(c.current + 1);
            total.textContent = String(slides.length);
            arrows[0].disabled = c.current <= 0;
            arrows[1].disabled = c.current === slides.length - 1;
          };
          c.go = (i: number) => {
            const slide = slides[Math.max(0, Math.min(slides.length - 1, i))];
            track.scrollTo({ left: slide.offsetLeft - pad(), behavior: smooth ? "smooth" : "auto" });
          };
          const show = (i: number) => {
            if (i === c.current) return;
            c.current = i;
            slides.forEach((s, k) => s.classList.toggle("is-active", k === i));
            marks.forEach((m, k) => (k === i ? m.setAttribute("aria-current", "true") : m.removeAttribute("aria-current")));
            c.count();
          };
          // the slide whose start is nearest the track's, or the last at the end
          const follow = () => {
            const x = track.scrollLeft + pad();
            let i = slides.reduce((best, s, k) => (Math.abs(s.offsetLeft - x) < Math.abs(slides[best].offsetLeft - x) ? k : best), 0);
            if (track.scrollLeft >= track.scrollWidth - track.clientWidth - 2) i = slides.length - 1;
            show(i);
          };
          let frame = 0;
          track.addEventListener("scroll", () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(follow); }, { passive: true });
          marks.forEach((m) => m.addEventListener("click", () => c.go(Number(m.dataset.carouselGo))));
          // a slide peeking in comes forward on a click, rather than opening full size
          slides.forEach((s, k) => s.addEventListener("click", (e) => {
            if (k === c.current) return;
            e.preventDefault();
            e.stopPropagation();
            c.go(k);
          }, { capture: true }));
          show(0);
          return c;
        });

        arrows.forEach((a) => a.addEventListener("click", () => carousels[active].go(carousels[active].current + Number(a.dataset.carouselStep))));
        switches.forEach((sw, n) => sw.addEventListener("click", () => {
          active = n;
          switches.forEach((x, k) => x.setAttribute("aria-selected", String(k === n)));
          panels.forEach((p, k) => (p.hidden = k !== n));
          carousels[n].count();
        }));
        carousels[0].count();
      }
    </script>

    <footer class="colophon">
      <span>Pinrail · a person in the loop of your agents.<small>No cookies: Cloudflare counts visits anonymously.</small></span>
      <nav><a href="/docs/">Docs</a><a href="/docs/building/writing/">Write a plugin</a><a href={repo}>GitHub</a><a href="/review">Review version</a></nav>
    </footer>
  </body>
</html>
