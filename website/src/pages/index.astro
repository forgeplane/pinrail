---
// Version 7, the usual way round: the same product and the same look as the
// page you review, laid out as a landing page for people who'd rather read.
import SocialCard from "../components/SocialCard.astro";
import "../styles/index.css";
import "../styles/index-classic.css";
import HeroDemo from "../components/index/HeroDemo.astro";
import HowItWorks from "../components/index/HowItWorks.astro";
import ViewsCarousel from "../components/index/ViewsCarousel.astro";
import RoundDemo from "../components/index/RoundDemo.astro";
import CliSession from "../components/index/CliSession.astro";
import { icons } from "../components/index/lucide";
import Lightbox from "../components/index/Lightbox.astro";
import ModeSwitch from "../components/index/ModeSwitch.astro";
import Footer from "../components/Footer.astro";
import Brand from "../components/Brand.astro";
import Download from "../components/Download.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Typed from "../components/index/Typed.astro";
import Faq from "../components/index/Faq.astro";
import { agents, codes, downloadPage, repo, samples, views } from "../components/index/content";

// every view in one carousel: those that decide what the agent does, then
// those on what it makes
const shown = [...views, ...samples];

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Before your agent acts, it asks. Pinrail is a desktop inbox where agents wait for your decision on a diff, a batch of emails or a page, or for your feedback on what they make, and carry on with it." />
    <meta name="theme-color" content="#f5f0e6" />
    <meta property="og:title" content="Pinrail — before your agent acts, it asks" />
    <meta property="og:description" content="A desktop inbox for agent work. Decide it, or mark it up, in a view made for it; your answer goes straight back." />
    <SocialCard />
    <title>Pinrail — before your agent acts, it asks</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist:wght@400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@500;700&display=swap" />
  </head>
  <body class="classic">
    <a href="#main" class="skip">Skip to content</a>

    <header class="topnav">
      <a class="brand" href="/" aria-label="Pinrail home"><Brand /></a>
      <nav class="links" aria-label="Main">
        <a href="#how">How it works</a><a href="#views">Views</a><a href="#cli">CLI</a><a href="#faq">FAQ</a><a href="/docs/">Docs</a><a href={repo}>GitHub ↗</a>
      </nav>
      <ModeSwitch current="classic" />
    </header>

    <main id="main">
      <section class="c-hero">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>The review inbox for agent work</p>
        <h1>Before your agent acts,<br /><em><Typed words={["it asks.", "you look.", "you decide.", "you edit.", "you say stop."]} /></em></h1>
        <p class="c-lede">Pinrail is a desktop inbox for the moments your agent needs you: review comments about to be posted, emails about to be sent, an illustration or a voice-over still taking shape.</p>
        <div class="c-ctas">
          <Download />
          <a class="ghost big" href="/docs/getting-started/install/">Read the docs</a>
        </div>
        <p class="c-fine">Free and open source · macOS and Linux, Windows soon · <a href={downloadPage}>every download</a> · in early development</p>
        <div class="c-shot">
          <span class="hand shot-note left" aria-hidden="true">click a review<svg class="scribble" viewBox="0 0 64 50"><path d="M2 12c14-7 34-8 44 2 7 7 8 17 6 30" /><path d="M44 36l8 9 7-10" /></svg></span>
          <HeroDemo />
        </div>
      </section>

      <section class="c-agents" aria-label="Works with any agent">
        <p>Works with any agent that can run a command</p>
        <ul>{agents.map((a) => <li><img src={`/agents/${a.icon}.svg`} width="20" height="20" alt="" />{a.name}</li>)}<li class="c-agents-more"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons["bot"]} />yours</li></ul>
      </section>

      <section class="c-section" id="how">
        <div class="c-head">
          <p class="kicker">01 · How it works</p>
          <h2>One command in, <em>one decision out.</em></h2>
          <p>You tell the agent when to stop for you, in whatever instructions it follows. When it gets there, it asks through Pinrail and waits.</p>
        </div>
        <HowItWorks />
      </section>

      <section class="c-section" id="views" data-carousels>
        <ViewsCarousel items={shown}>
          <div class="c-head">
            <p class="kicker">02 · Views</p>
            <h2>A diff deserves a diff. <em>A picture deserves a pen.</em></h2>
            <p>Each kind of request is a plugin, with a view made for deciding it: the diff for a code review, the draft itself for an email, the image for a picture, the waveform for a voice take. What you say goes back with what it points at, down to the line, the pixel or the millisecond.</p>
          </div>
        </ViewsCarousel>
        <div class="c-own">
          <code>pinrail plugins new my_plugin</code>
          <p><b>The next one is yours.</b> A plugin is a manifest, two JSON schemas and a web page, built with any web framework you like, or none at all. Storyboards, floor plans, moodboards, a map with a no-go zone scribbled on it: if your agent can make it, you can put it in front of your eyes and mark it up. The only limits are your imagination and your agent's.</p>
          <a href="/docs/building/writing/">Write a plugin →</a>
        </div>
      </section>

      <section class="c-section c-split">
        <div>
          <p class="kicker">03 · Rounds</p>
          <h2>A no comes with a reason, <em>and the reason comes back.</em></h2>
          <p>Send something back and the agent answers with a new round, submitted with <code>--revises</code>. It lands beside your earlier verdicts and comments, so you see what changed and why, and a view can set the two rounds side by side to check each fix. Every round and every decision is kept, and can be opened again later.</p>
          <RoundDemo />
        </div>
        <div>
          <p class="kicker">04 · Stop</p>
          <h2>“Stop” is <em>a real answer.</em></h2>
          <p>Discard a review with a reason and the waiting command exits 5. The agent stops the work the review was gating, reports why, and doesn't try again. Every ending has its code:</p>
          <table class="codes">
            <tbody>{codes.map(([c, t]) => <tr class={c === "5" ? "stop" : undefined}><td>{c}</td><td>{t}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="c-section c-cli" id="cli">
        <div class="c-head">
          <p class="kicker">05 · The CLI</p>
          <h2>For an agent, <em>and for a script.</em></h2>
          <p>An agent reads the decision as markdown. A script keeps the JSON and branches on the exit code, and <code>--decision-out</code> writes the decision to a file for a workflow that already reads one.</p>
        </div>
        <CliSession />
      </section>

      <section class="c-section c-faq" id="faq">
        <div class="c-head">
          <p class="kicker">06 · Questions</p>
          <h2>Before you <em>ask.</em></h2>
        </div>
        <div class="faq-list"><Faq /></div>
      </section>

      <section class="c-final">
        <p class="hand">your move</p>
        <h2 class="closing-title"><span class="line">Put <em><Typed words={["a pinrail", "a second look", "a red pen", "your judgment", "a person"]} /></em></span><br /><span class="line">in front of your agents.</span></h2>
        <p>macOS and Linux today, Windows soon.</p>
        <div class="c-ctas">
          <Download />
          <a class="ghost big on-dark" href={repo}><GitHubIcon />Star on GitHub</a>
        </div>
        <a class="try-review" href="/review">Or skip the reading: review this page instead →</a>
      </section>
    </main>

    <Lightbox />


    <Footer other={{ href: "/review", label: "Review version" }} />
  </body>
</html>
