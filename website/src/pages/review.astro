---
// Version 7: the page is itself a review. An agent drafted the landing page
// and submitted it; the visitor is the person at the pinrail. Each section is
// an item to accept or send back with a reason, a rejection comes back as a
// second round, the decision builds up as JSON beside the page, and handing it
// back plays out in the agent's terminal.
import path from "node:path";
import "../styles/index.css";
import { videos } from "../videos.mjs";
import Zoom from "../components/index/Zoom.astro";
import Download from "../components/Download.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Lightbox from "../components/index/Lightbox.astro";
import ModeSwitch from "../components/index/ModeSwitch.astro";
import Brand from "../components/Brand.astro";
import Typed from "../components/index/Typed.astro";
import Faq from "../components/index/Faq.astro";
import HeroDemo from "../components/index/HeroDemo.astro";
import HowItWorks from "../components/index/HowItWorks.astro";
import RoundDemo from "../components/index/RoundDemo.astro";
import CliSession from "../components/index/CliSession.astro";
import ViewsCarousel from "../components/index/ViewsCarousel.astro";
import { codes, repo, samples, views } from "../components/index/content";

// The promo, for the hero's video round: in development from the
// repository's agent-docs, in a build from media.pinrail.dev
const promo = import.meta.env.DEV
  ? { src: `/@fs${path.resolve("..", videos.promo.local)}`, poster: `/@fs${path.resolve("..", videos.promo.localPoster)}` }
  : videos.promo;

// the views the review page shows first, in a carousel; the rest are an option
const all = [...views, ...samples];
const firstFive = ["code-review", "email", "image", "audio", "video"].map((p) => all.find((v) => v.plugin === p)!);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Before your agent acts, it asks. Pinrail is a desktop inbox where agents wait for your decision: a diff, a batch of emails, a page. Review this page to see how it works." />
    <meta name="theme-color" content="#f5f0e6" />
    <meta property="og:title" content="Pinrail — before your agent acts, it asks" />
    <meta property="og:description" content="An agent drafted this page and is waiting for your review." />
    <title>Pinrail — review this page</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@500;700&display=swap" />
  </head>
  <body data-phase="reviewing">
    <a href="#main" class="skip">Skip to the draft</a>

    <header class="gatebar" aria-label="Review">
      <a class="brand" href="/" aria-label="Pinrail home"><Brand /></a>
      <div class="review-title">
        <span class="review-plugin">list</span>
        <span class="review-name">Landing page, draft 1</span>
        <span class="review-wait"><span class="pulse" aria-hidden="true"></span><span data-waiting>An agent is waiting on you</span></span>
      </div>
      <ModeSwitch current="review" />
      <div class="review-progress" aria-live="polite"><span data-count>0 of 6</span> decided<span class="track" aria-hidden="true"><span data-bar></span></span></div>
      <div class="review-actions">
        <button type="button" class="ghost" data-discard>Discard</button>
        <button type="button" class="primary" data-handback>Hand back <kbd>⌘↵</kbd></button>
      </div>
    </header>

    <div class="discarded" role="alert" hidden>
      <p><strong>Discarded.</strong> The agent's <code>pinrail submit --wait</code> exited <b>5</b>: it stops the work this review was gating, reports your reason, and doesn't try again.</p>
      <button type="button" data-undiscard>Undo, I was only testing it</button>
    </div>

    <div class="layout">
      <main id="main" class="manuscript">
        <p class="preamble"><span class="hand">↓ you're the reviewer</span>An agent wrote this page and submitted it for review. Accept each section or send it back with a reason, then hand your decision back. <span class="keys">Keys: <kbd>J</kbd><kbd>K</kbd> move, <kbd>A</kbd> accept, <kbd>R</kbd> reject.</span></p>

        <!-- 101: the hero -->
        <article class="item hero wide" data-id="101" data-first="Show the app window" data-title="Headline" tabindex="-1">
          <div class="gutter"><span class="iid">#101</span><span class="round">R1</span><svg class="mark" viewBox="0 0 60 50" aria-hidden="true"><path class="tick" d="M6 28 L22 42 L54 6" /><path class="cross" d="M10 8 L50 44 M50 8 L10 44" /></svg></div>
          <div class="body">
            <div class="content" data-round="1">
              <h1 class="hero-title"><span class="line">Before your agent</span><br />acts, <em><Typed words={["it asks.", "you look.", "you decide.", "you edit.", "you say stop."]} /></em></h1>
              <p class="lede">Pinrail is a desktop inbox for the moments your agent needs you: review comments about to be posted, emails about to be sent, an illustration or a voice-over still taking shape.</p>
              <div class="hero-window"><HeroDemo /></div>
            </div>
            <template data-round="2" data-option="video" data-label="Show the promo video instead">
              <div class="content" data-round="2">
                <h1 class="hero-title"><span class="line">Before your agent</span><br />acts, <em>it asks.</em></h1>
                <p class="lede">Pinrail is a desktop inbox for the moments your agent needs you: review comments about to be posted, emails about to be sent, an illustration or a voice-over still taking shape.</p>
                <div class="hero-window"><video class="promo" src={promo.src} poster={promo.poster} controls playsinline preload="metadata"></video></div>
              </div>
            </template>
            <template data-round="2" data-option="angle" data-label="Try another angle">
              <div class="content" data-round="2">
                <h1>Your agents do the work. <em>You keep the final say.</em></h1>
                <p class="lede">Agents stop at the steps you pick and wait in one inbox on your computer. You look at the actual work, decide, and your decision goes back to them as something they can act on.</p>
              </div>
            </template>
          </div>
          <aside class="note" data-round="1"><b>agent</b>I kept the headline short. There was a longer one about “revolutionizing human–AI collaboration”. You're welcome.</aside>
          <template data-note="2" data-option="video"><aside class="note" data-round="2"><b>agent</b>The minute-long promo, then, in place of the window. It starts when you press play.</aside></template>
          <template data-note="2" data-option="angle"><aside class="note" data-round="2"><b>agent</b>Another angle, then: the division of labour instead of the mechanism.</aside></template>
        </article>

        <!-- 102: the loop -->
        <article class="item wide" data-id="102" data-first="Play it out" data-title="How it works" tabindex="-1">
          <div class="gutter"><span class="iid">#102</span><span class="round">R1</span><svg class="mark" viewBox="0 0 60 50" aria-hidden="true"><path class="tick" d="M6 28 L22 42 L54 6" /><path class="cross" d="M10 8 L50 44 M50 8 L10 44" /></svg></div>
          <div class="body">
            <div class="content" data-round="1">
              <h2>One command in, one decision out.</h2>
              <p>You tell the agent when to stop for you, in whatever instructions it follows. When it gets there, it asks through Pinrail and waits.</p>
              <HowItWorks />
            </div>
                        <template data-round="2" data-option="diagram" data-label="As a diagram">
              <div class="content" data-round="2">
                <h2>One command in, one decision out.</h2>
                <div class="loop-diagram" role="img" aria-label="The agent submits and waits; Pinrail shows the work to you; you decide; the decision and an exit code go back to the agent">
                  <div class="ld-card">
                    <span class="ld-who">agent</span>
                    <code>$ pinrail submit … --wait</code>
                    <small>blocks until you decide</small>
                  </div>
                  <div class="ld-edge"><span>payload</span></div>
                  <div class="ld-card">
                    <span class="ld-who">Pinrail</span>
                    <span class="ld-view"><i></i><i></i><i></i></span>
                    <small>a view made for the work</small>
                  </div>
                  <div class="ld-edge"><span>notifies</span></div>
                  <div class="ld-card you">
                    <span class="ld-who">you</span>
                    <span class="ld-acts"><b class="ok">✓ Accept</b><b class="no">✕ Send back</b></span>
                    <small>with a note, a reason, a comment</small>
                  </div>
                  <div class="ld-return"><span>decision · exit 0</span></div>
                </div>
              </div>
            </template>
            <template data-round="2" data-option="sentence" data-label="Say it in one sentence">
              <div class="content" data-round="2">
                <h2>One command in, one decision out.</h2>
                <p class="plain">The agent runs <code>pinrail submit … --wait</code> and waits. You decide in the app. The command returns your decision, and the agent carries on with it.</p>
              </div>
            </template>
          </div>
          <aside class="note" data-round="1"><b>agent</b>It plays itself. Reject it and I'll say it in one sentence.</aside>
          <template data-note="2" data-option="diagram"><aside class="note" data-round="2"><b>agent</b>Three steps and the way back. The session is still on the home page.</aside></template>
          <template data-note="2" data-option="sentence"><aside class="note" data-round="2"><b>agent</b>Fine. One sentence, no steps.</aside></template>
        </article>

        <!-- 103: the views -->
        <article class="item wide" data-id="103" data-first="Back to the carousel" data-title="Views" tabindex="-1">
          <div class="gutter"><span class="iid">#103</span><span class="round">R1</span><svg class="mark" viewBox="0 0 60 50" aria-hidden="true"><path class="tick" d="M6 28 L22 42 L54 6" /><path class="cross" d="M10 8 L50 44 M50 8 L10 44" /></svg></div>
          <div class="body">
            <div class="content" data-round="1">
              <h2>A diff deserves a diff.</h2>
              <p>Each kind of request is a plugin, with a view made for deciding it: the diff for a code review, the draft itself for an email, the image for a picture, the waveform for a voice take. This page is using <code>list</code>.</p>
              <div class="review-carousel" data-carousels><ViewsCarousel items={firstFive} /></div>
            </div>
            <template data-round="2" data-option="cards" data-label="Show them all as cards">
              <div class="content" data-round="2">
                <h2>A diff deserves a diff.</h2>
                <p>All ten, side by side. Five come with the app; the others are a click away.</p>
                <div class="views">
                  {all.map((v, i) => (
                    <figure class="view" style={`--tilt:${[-1.2, 0.8, -0.6, 1.1, -0.9][i % 5]}deg`}>
                      <Zoom src={v.image} alt={v.alt} caption={`${v.name}: ${v.detail}`} sizes="(max-width: 700px) 90vw, 320px" />
                      <figcaption><b>{v.name}</b>{v.detail}</figcaption>
                    </figure>
                  ))}
                  <figure class="view own">
                    <div class="own-body"><code>pinrail plugins new my_plugin</code><p>A manifest, two JSON schemas and an HTML page. Triage alerts, approve a deploy, answer an agent's questions: whatever your agents do.</p></div>
                    <figcaption><b>Your own</b>Run it in a browser without the app, then install it from a folder or a GitHub release.</figcaption>
                  </figure>
                </div>
              </div>
            </template>
            <template data-round="2" data-option="shorter" data-label="Shorter">
              <div class="content" data-round="2">
                <h2>A diff deserves a diff.</h2>
                <p>A code review comes as a diff, an image as an image, a voice take as a waveform. What you say goes back with what it points at: the line, the pixel, the millisecond.</p>
              </div>
            </template>
            <template data-round="2" data-option="list" data-label="Just the list">
              <div class="content" data-round="2">
                <h2>A diff deserves a diff.</h2>
                <dl class="plain-views">
                  {all.map((v) => (
                    <div><dt>{v.plugin}</dt><dd>{v.gist}</dd></div>
                  ))}
                  <div><dt>yours</dt><dd>a manifest, two schemas and an HTML view</dd></div>
                </dl>
              </div>
            </template>
          </div>
          <aside class="note" data-round="1"><b>agent</b>Five of the ten, screenshots of the real app. I didn't draw them.</aside>
          <template data-note="2" data-option="cards"><aside class="note" data-round="2"><b>agent</b>All of them, then. Click one to see it full size.</aside></template>
          <template data-note="2" data-option="shorter"><aside class="note" data-round="2"><b>agent</b>No pictures. You've seen them on the home page.</aside></template>
          <template data-note="2" data-option="list"><aside class="note" data-round="2"><b>agent</b>A plainer version: the whole list, no pictures.</aside></template>
        </article>

        <!-- 104: rounds -->
        <article class="item" data-id="104" data-first="With the example" data-title="Rounds" tabindex="-1">
          <div class="gutter"><span class="iid">#104</span><span class="round">R1</span><svg class="mark" viewBox="0 0 60 50" aria-hidden="true"><path class="tick" d="M6 28 L22 42 L54 6" /><path class="cross" d="M10 8 L50 44 M50 8 L10 44" /></svg></div>
          <div class="body">
            <div class="content" data-round="1">
              <h2>A no comes with a reason, and the reason comes back.</h2>
              <p>Send something back and the agent answers with a new round, submitted with <code>--revises</code>. It lands beside your earlier verdicts and comments, so you see what changed and why, and a view can set the two rounds side by side to check each fix. Every round and every decision is kept, and can be opened again later.</p>
              <RoundDemo />
              <p class="aside-hint">Try it: send a section above back and see what comes back.</p>
            </div>
                        <template data-round="2" data-option="both" data-label="Show both rounds">
              <div class="content" data-round="2">
                <h2>A no comes with a reason, and the reason comes back.</h2>
                <div class="both-rounds">
                  <figure><figcaption>Round 1 · sent back</figcaption><p><s>Retry failed payments automatically.</s></p><p class="why">✕ “could charge twice”</p></figure>
                  <figure class="now"><figcaption>Round 2 · <code>--revises</code> round 1</figcaption><p>Retry failed payments with the idempotency key.</p><p class="why">answers “could charge twice”</p></figure>
                </div>
              </div>
            </template>
            <template data-round="2" data-option="plainer" data-label="Say it plainer">
              <div class="content" data-round="2">
                <h2>Say no. Say why. Get round two.</h2>
                <p>A rejection carries its reason back to the agent. The next round shows up next to your earlier verdicts, and none of it is thrown away.</p>
              </div>
            </template>
          </div>
          <aside class="note" data-round="1"><b>agent</b>You may have noticed you're doing this right now.</aside>
          <template data-note="2" data-option="both"><aside class="note" data-round="2"><b>agent</b>Side by side, the way a view can show them.</aside></template>
          <template data-note="2" data-option="plainer"><aside class="note" data-round="2"><b>agent</b>Round two of the section about round two.</aside></template>
        </article>

        <!-- 105: stop -->
        <article class="item" data-id="105" data-first="With the exit codes" data-title="Stop" tabindex="-1">
          <div class="gutter"><span class="iid">#105</span><span class="round">R1</span><svg class="mark" viewBox="0 0 60 50" aria-hidden="true"><path class="tick" d="M6 28 L22 42 L54 6" /><path class="cross" d="M10 8 L50 44 M50 8 L10 44" /></svg></div>
          <div class="body">
            <div class="content" data-round="1">
              <h2>“Stop” is a real answer.</h2>
              <p>Discard a review with a reason and the waiting command exits 5. The agent stops the work the review was gating, reports why, and doesn't try again. Every ending has its code:</p>
              <table class="codes">
                <tbody>{codes.map(([c, t]) => <tr class={c === "5" ? "stop" : undefined}><td>{c}</td><td>{t}</td></tr>)}</tbody>
              </table>
            </div>
                        <template data-round="2" data-option="happening" data-label="Show it happening">
              <div class="content" data-round="2">
                <h2>“Stop” is a real answer.</h2>
                <div class="terminal cli-session"><div class="term-bar"><span></span><span></span><span></span><b>agent — zsh</b></div><pre><span class="t-cmd">$ pinrail submit list --title "Delete 1,284 inactive accounts" \
    --data accounts.json --wait</span>
<span class="t-dim">pinrail: review r_01K5R7 submitted; waiting for a decision</span>
r_01K5R7 · discarded · Delete 1,284 inactive accounts
<span class="t-no">Discarded by maya: legal hasn't signed off on the retention policy.</span>
<span class="t-cmd">$ echo $?</span>
<span class="t-no">5</span>
<span class="t-dim">agent ▸ Stopping here. Nothing was deleted; I'll report the reason.</span></pre></div>
              </div>
            </template>
            <template data-round="2" data-option="shorter" data-label="Shorter">
              <div class="content" data-round="2">
                <h2>“Stop” is a real answer.</h2>
                <p>Discard a review and the agent's command exits 5. It stops, tells you why, and leaves it there.</p>
              </div>
            </template>
          </div>
          <aside class="note" data-round="1"><b>agent</b>Please don't test this on the page. (The Discard button is at the top.)</aside>
          <template data-note="2" data-option="happening"><aside class="note" data-round="2"><b>agent</b>That one really happens. Nothing gets deleted.</aside></template>
          <template data-note="2" data-option="shorter"><aside class="note" data-round="2"><b>agent</b>Shorter this time.</aside></template>
        </article>

        <!-- 106: the CLI -->
        <article class="item wide" data-id="106" data-first="With the agent's session" data-title="The CLI" tabindex="-1">
          <div class="gutter"><span class="iid">#106</span><span class="round">R1</span><svg class="mark" viewBox="0 0 60 50" aria-hidden="true"><path class="tick" d="M6 28 L22 42 L54 6" /><path class="cross" d="M10 8 L50 44 M50 8 L10 44" /></svg></div>
          <div class="body">
            <div class="content" data-round="1">
              <h2>For an agent, and for a script.</h2>
              <p>An agent reads the decision as markdown. A script keeps the JSON and branches on the exit code, and <code>--decision-out</code> writes the decision to a file for a workflow that already reads one.</p>
              <CliSession />
            </div>
                        <template data-round="2" data-option="script" data-label="Show it for a script">
              <div class="content" data-round="2">
                <h2>For an agent, and for a script.</h2>
                <p>A script reads the decision from a file and branches on the exit code.</p>
                <div class="terminal cli-session"><div class="term-bar"><span></span><span></span><span></span><b>agent — zsh</b></div><pre><span class="t-dim"># deploy only what a person approved</span>
<span class="t-cmd">$ pinrail submit list --title "Release 2.4.1" --data changes.json \
    --wait --decision-out decision.json > /dev/null</span>
<span class="t-cmd">$ case $? in
    0) jq -r '.decisions[] | select(.action == "accept") | .id' decision.json \
         | xargs ./deploy ;;
    5) echo "stopped: a person said no" ;;
    *) echo "no decision yet" ;;
  esac</span>
<span class="t-ok">deploying 3 of 4 changes</span></pre></div>
              </div>
            </template>
            <template data-round="2" data-option="plain" data-label="No terminal">
              <div class="content" data-round="2">
                <h2>For an agent, and for a script.</h2>
                <p>One command: <code>pinrail submit … --wait</code>. It prints the decision, as Markdown for an agent or JSON for a script, and its exit code says how the review ended.</p>
              </div>
            </template>
          </div>
          <aside class="note" data-round="1"><b>agent</b>That's a real session. The comments are made up.</aside>
          <template data-note="2" data-option="script"><aside class="note" data-round="2"><b>agent</b>The same call, for a shell script instead of me.</aside></template>
          <template data-note="2" data-option="plain"><aside class="note" data-round="2"><b>agent</b>No terminal this time.</aside></template>
        </article>

        <section class="handover" aria-labelledby="handover-title">
          <h2 id="handover-title">Done reviewing?</h2>
          <p data-summary>Nothing decided yet. Items you leave undecided go back as not approved.</p>
          <div class="confirm" role="alert" hidden>
            <p><b data-undecided-count></b> left undecided. The agent treats those as not approved.</p>
            <button type="button" class="primary" data-confirm>Hand back anyway</button>
            <button type="button" class="ghost" data-cancel>Keep reviewing</button>
          </div>
          <button type="button" class="primary big" data-handback>Hand back to the agent <kbd>⌘↵</kbd></button>
        </section>

        <section class="terminal-wrap" aria-label="The agent's terminal" hidden>
          <div class="terminal">
            <div class="term-bar"><span></span><span></span><span></span><b>agent — zsh</b></div>
            <pre data-term aria-live="polite"></pre>
          </div>
          <div class="finale" hidden>
            <p class="hand big-hand">That's the whole loop.</p>
            <h2 class="closing-title"><span class="line">Put <em><Typed words={["a pinrail", "a second look", "a red pen", "your judgment", "a person"]} /></em></span><br /><span class="line">in front of your agents.</span></h2>
            <p>macOS and Linux today, Windows soon. Free and open source, in early development.</p>
            <div class="ctas">
              <Download />
              <a class="ghost big" href="/docs/getting-started/install/">Read the docs</a>
              <a class="ghost big" href={repo}><GitHubIcon />Star on GitHub</a>
            </div>
            <button type="button" class="restart" data-restart>Review the draft again</button>
          </div>
        </section>
      </main>

      <aside class="decision" aria-label="Your decision so far">
        <details open>
          <summary><span class="file">decision.json</span><span class="state" data-saved>draft</span></summary>
          <pre data-json></pre>
          <p class="decision-foot">This is what the agent gets back. Every click is structured data, not a chat message it has to interpret.</p>
          <div class="faq" aria-label="Questions">
            <p class="faq-label">Questions</p>
            <Faq beside />
          </div>
        </details>
      </aside>
    </div>

    <form class="reasons" hidden aria-label="Why send this back?">
      <p class="reasons-q">What should the agent know?</p>
      <div class="chips" data-chips></div>
      <div class="reason-row">
        <input type="text" name="note" placeholder="Or say it in your own words…" autocomplete="off" />
        <button type="submit" class="primary">Send back</button>
      </div>
      <p class="reasons-fine">The agent reads your reasons when you hand back, and answers with the next round.</p>
    </form>

    <Lightbox />

    <footer class="colophon">
      <span>Pinrail · a person in the loop of your agents.<small>No cookies: Cloudflare counts visits anonymously.</small><small>Product names and logos belong to their owners and are shown only to say which agents Pinrail works with. Pinrail is not affiliated with them or endorsed by them.</small></span>
      <nav><a href="/docs/">Docs</a><a href="/docs/building/writing/">Write a plugin</a><a href={repo}>GitHub</a><a href="/">Classic version</a></nav>
    </footer>

    <script>
      type Verdict = { action: "accept" | "reject"; note?: string; option?: string };
      type Item = { el: HTMLElement; id: number; title: string; round: number; showing: string; verdict?: Verdict; history: string[] };

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items: Item[] = [...document.querySelectorAll<HTMLElement>("article.item")].map((el) => ({
        el, id: Number(el.dataset.id), title: el.dataset.title!, round: 1, showing: "first", history: [],
      }));
      const reasons = document.querySelector<HTMLFormElement>(".reasons")!;
      const json = document.querySelector<HTMLElement>("[data-json]")!;
      let current = 0;
      let reasonFor: Item | null = null;
      let lastJson = "";

      // Each item gets its verdict controls; the markup stays readable without them.
      for (const item of items) {
        const bar = document.createElement("div");
        bar.className = "verdict";
        bar.innerHTML = `<button type="button" class="accept" data-act="accept"><span aria-hidden="true">✓</span> Accept</button><button type="button" class="reject" data-act="reject"><span aria-hidden="true">✕</span> Send back</button><span class="verdict-label" aria-live="polite"></span><button type="button" class="undo" data-act="undo" hidden>Change</button>`;
        item.el.querySelector(".body")!.append(bar);
        bar.addEventListener("click", (e) => {
          const act = (e.target as HTMLElement).closest("button")?.dataset.act;
          if (act === "accept") decide(item, { action: "accept" });
          if (act === "reject") askWhy(item);
          if (act === "undo") { item.verdict = undefined; closeReasons(); render(); }
        });
        item.el.addEventListener("focusin", () => { current = items.indexOf(item); mark(); });
        item.el.addEventListener("pointerdown", () => { current = items.indexOf(item); mark(); });
      }

      // A verdict is recorded and nothing more: the agent answers a sent-back
      // section in the next round, after the decision is handed back.
      function decide(item: Item, verdict: Verdict) {
        item.verdict = verdict;
        closeReasons();
        render();
        next();
      }

      // Every version of a section the agent has: the first draft, kept as it
      // is so its scripts still run, and the others as templates. The chips
      // are each version but the one showing, so any round can go to any.
      const firsts = new Map(items.map((it) => [it, {
        content: it.el.querySelector<HTMLElement>('.content[data-round="1"]')!,
        note: it.el.querySelector<HTMLElement>('.note[data-round="1"]')!,
      }]));
      const options = (item: Item) =>
        [
          { id: "first", label: item.el.dataset.first! },
          ...[...item.el.querySelectorAll<HTMLTemplateElement>('template[data-round="2"]')].map((t) => ({ id: t.dataset.option!, label: t.dataset.label! })),
        ].filter((o) => o.id !== item.showing);

      function askWhy(item: Item) {
        reasonFor = item;
        const chips = reasons.querySelector<HTMLElement>("[data-chips]")!;
        chips.replaceChildren(...options(item).map((o) => {
          const chip = document.createElement("button");
          chip.type = "button";
          chip.className = "chip";
          chip.dataset.reason = o.label;
          chip.dataset.option = o.id;
          chip.textContent = o.label;
          return chip;
        }));
        chips.hidden = !chips.children.length;
        item.el.querySelector(".verdict")!.after(reasons);
        reasons.hidden = false;
        reasons.reset();
        reasons.querySelector<HTMLInputElement>("input")!.focus({ preventScroll: true });
      }
      function closeReasons() { reasons.hidden = true; reasonFor = null; }
      reasons.addEventListener("click", (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLElement>("[data-reason]");
        if (chip && reasonFor) decide(reasonFor, { action: "reject", note: chip.dataset.reason, option: chip.dataset.option });
      });
      reasons.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!reasonFor) return;
        const note = reasons.querySelector<HTMLInputElement>("input")!.value.trim();
        // a reason in the person's own words: the agent's first version answers it
        decide(reasonFor, { action: "reject", note: note || undefined, option: options(reasonFor)[0]?.id });
      });
      reasons.addEventListener("keydown", (e) => { if (e.key === "Escape") { const it = reasonFor; closeReasons(); it?.el.focus(); } });

      // Round two: the agent takes the reason and sends the section again,
      // with the first round's verdict kept beside it.
      function revise(item: Item, option: string, note: string) {
        const el = item.el;
        el.classList.add("revising");
        setTimeout(() => {
          const body = el.querySelector(".body")!;
          const first = firsts.get(item)!;
          const content = option === "first"
            ? first.content
            : (el.querySelector<HTMLTemplateElement>(`template[data-round="2"][data-option="${option}"]`)!.content.firstElementChild!.cloneNode(true) as HTMLElement);
          const aside = option === "first"
            ? first.note
            : (el.querySelector<HTMLTemplateElement>(`template[data-note="2"][data-option="${option}"]`)!.content.firstElementChild!.cloneNode(true) as HTMLElement);
          body.querySelector(".content")!.replaceWith(content);
          el.querySelector(".note")!.replaceWith(aside);
          item.history.push(`Round ${item.round}: sent back — “${note}”`);
          item.round += 1;
          item.showing = option;
          item.verdict = undefined;
          body.querySelector(".previous")?.remove();
          const prev = document.createElement("p");
          prev.className = "previous";
          prev.textContent = item.history.at(-1)!;
          content.before(prev);
          el.classList.remove("revising");
          el.classList.add("arrived");
          setTimeout(() => el.classList.remove("arrived"), 1200);
          render();
        }, reduce ? 0 : 600);
      }

      function next() {
        const pending = items.findIndex((it, i) => i > current && !it.verdict);
        if (pending >= 0) focusItem(pending);
      }
      function focusItem(i: number) {
        current = Math.max(0, Math.min(items.length - 1, i));
        items[current].el.focus({ preventScroll: true });
        items[current].el.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
        mark();
      }
      function mark() { items.forEach((it, i) => it.el.classList.toggle("current", i === current)); }

      function decision() {
        const decided = items.filter((it) => it.verdict);
        return {
          decisions: decided.map((it) => ({ id: it.id, action: it.verdict!.action, ...(it.verdict!.note ? { note: it.verdict!.note } : {}) })),
          undecided: items.filter((it) => !it.verdict).map((it) => it.id),
        };
      }

      function highlight(src: string) {
        const esc = src.replace(/&/g, "&amp;").replace(/</g, "&lt;");
        return esc
          .replace(/("[a-z]+")(?=:)/g, '<span class="k">$1</span>')
          .replace(/: ("accept")/g, ': <span class="ok">$1</span>')
          .replace(/: ("reject")/g, ': <span class="no">$1</span>')
          .replace(/: ("[^"]*")(?!<)/g, ': <span class="s">$1</span>')
          .replace(/\b(\d{3})\b/g, '<span class="n">$1</span>');
      }
      function pretty(d: ReturnType<typeof decision>) {
        const rows = d.decisions.map((r) => "    " + JSON.stringify(r).replace(/,"/g, ', "').replace(/":/g, '": ').replace(/^\{/, "{ ").replace(/\}$/, " }"));
        const undecided = d.undecided.length ? `[ ${d.undecided.join(", ")} ]` : "[]";
        return `{\n  "decisions": [${rows.length ? "\n" + rows.join(",\n") + "\n  " : ""}],\n  "undecided": ${undecided}\n}`;
      }

      function render() {
        for (const it of items) {
          const state = it.verdict ? (it.verdict.action === "accept" ? "accepted" : "rejected") : "pending";
          it.el.dataset.state = state;
          it.el.querySelector(".round")!.textContent = `R${it.round}`;
          const label = it.el.querySelector<HTMLElement>(".verdict-label")!;
          label.textContent = it.verdict ? (it.verdict.action === "accept" ? "Accepted" : `Sent back${it.verdict.note ? ` — “${it.verdict.note}”` : ""}`) : "";
          it.el.querySelector<HTMLElement>(".undo")!.hidden = !it.verdict;
          it.el.querySelectorAll<HTMLButtonElement>(".accept, .reject").forEach((b) => (b.hidden = !!it.verdict));
        }
        const d = decision();
        const done = d.decisions.length;
        document.querySelector("[data-count]")!.textContent = `${done} of ${items.length}`;
        document.querySelector<HTMLElement>("[data-bar]")!.style.width = `${(done / items.length) * 100}%`;
        const text = pretty(d);
        if (text !== lastJson) {
          json.innerHTML = highlight(text);
          json.classList.remove("flash"); void json.offsetWidth; json.classList.add("flash");
          lastJson = text;
        }
        const accepted = d.decisions.filter((r) => r.action === "accept").length;
        const summary = document.querySelector("[data-summary]")!;
        summary.textContent = done
          ? `${accepted} accepted, ${done - accepted} sent back, ${d.undecided.length} undecided.`
          : "Nothing decided yet. Items you leave undecided go back as not approved.";
      }

      // Hand back: the decision goes to the agent's waiting command.
      const confirm = document.querySelector<HTMLElement>(".confirm")!;
      document.querySelectorAll("[data-handback]").forEach((b) => b.addEventListener("click", handback));
      document.querySelector("[data-confirm]")!.addEventListener("click", () => { confirm.hidden = true; finish(); });
      document.querySelector("[data-cancel]")!.addEventListener("click", () => { confirm.hidden = true; focusItem(items.findIndex((it) => !it.verdict)); });

      function handback() {
        if (document.body.dataset.phase !== "reviewing") return;
        const undecided = items.filter((it) => !it.verdict).length;
        if (undecided) {
          document.querySelector("[data-undecided-count]")!.textContent = `${undecided} ${undecided === 1 ? "item is" : "items are"}`;
          confirm.hidden = false;
          confirm.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
          confirm.querySelector<HTMLElement>("[data-confirm]")!.focus({ preventScroll: true });
          return;
        }
        finish();
      }

      // Each hand-back plays out in the agent's terminal, which keeps every
      // round. A section sent back with a version still to come is revised:
      // the agent submits the next draft with --revises, and the page shows
      // it to review. With none to revise, the agent carries on and it ends.
      // the agent's terminal keeps one height and follows its newest line
      const termEl = document.querySelector<HTMLElement>("[data-term]")!;
      new MutationObserver(() => { termEl.scrollTop = termEl.scrollHeight; }).observe(termEl, { subtree: true, childList: true, characterData: true });
      let draft = 1;
      const reviewId = (n: number) => `r_01K5Q${(8 + n).toString(36).toUpperCase()}`;
      async function finish() {
        closeReasons();
        document.body.dataset.phase = "handed";
        document.querySelector("[data-saved]")!.textContent = "handed over";
        document.querySelector("[data-waiting]")!.textContent = "Decision handed back";
        const wrap = document.querySelector<HTMLElement>(".terminal-wrap")!;
        const term = document.querySelector<HTMLElement>("[data-term]")!;
        wrap.hidden = false;
        if (draft === 1) term.textContent = "";
        else term.append("\n");
        wrap.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });

        const d = decision();
        const accepted = d.decisions.filter((r) => r.action === "accept");
        const rejected = items.filter((it) => it.verdict?.action === "reject");
        const toRevise = rejected.filter((it) => it.verdict!.option);
        const now = new Date();
        const pad = (n: number) => String(n).padStart(2, "0");
        const at = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
        const title = `Landing page, draft ${draft}`;
        // the lines the list plugin prints, one per item in the page's order
        const itemLines = items.flatMap((it): [string, string, number][] => {
          const v = it.verdict;
          if (!v) return [["dim", `- **#${it.id} undecided, not approved** — ${it.title}`, 70]];
          const line: [string, string, number] = [v.action === "accept" ? "ok" : "no", `- **#${it.id} ${v.action === "accept" ? "accepted" : "rejected"}** — ${it.title}`, 70];
          return v.note ? [line, ["out", `  > ${v.note}`, 40]] : [line];
        });
        const submit = `pinrail submit list --title "${title}" \\\n    --data page.json --wait`;
        const lines: [string, string, number][] = [
          ...(draft === 1 ? [["cmd", submit, 420] as [string, string, number], ["dim", `pinrail: review ${reviewId(draft)} submitted; waiting for a decision`, 700] as [string, string, number]] : []),
          ["out", `${reviewId(draft)} · decided · ${title}`, 60],
          ["out", `list · decided by you at ${at}`, 60],
          ["out", "", 20],
          ["out", "## Landing page", 40],
          ["out", "", 20],
          ...itemLines,
          ["cmd", "echo $?", 380],
          ["out", "0", 300],
        ];
        if (toRevise.length) {
          lines.push(
            ["agent", `Revising ${toRevise.map((it) => it.title).join(", ")}, as you asked. The rest stays as you left it.`, 700],
            ["cmd", `pinrail submit list --title "Landing page, draft ${draft + 1}" \\\n    --revises ${reviewId(draft)} --data page.json --wait`, 420],
            ["dim", `pinrail: review ${reviewId(draft + 1)} submitted; waiting for a decision`, 600],
          );
        } else {
          lines.push(["agent", agentReply(accepted.length, rejected.map((it) => it.title), d.undecided.length), 500]);
        }
        for (const [kind, text, pause] of lines) {
          const line = document.createElement("span");
          line.className = `t-${kind}`;
          term.append(line, "\n");
          const prefix = kind === "cmd" ? "$ " : kind === "agent" ? "agent ▸ " : "";
          if (kind === "cmd" && !reduce) {
            line.textContent = prefix;
            for (const ch of text) { line.textContent += ch; await wait(14); }
          } else line.textContent = prefix + text;
          await wait(reduce ? 0 : pause);
        }
        if (!toRevise.length) {
          document.querySelector<HTMLElement>(".finale")!.hidden = false;
          return;
        }

        // the next draft: the sections sent back come back revised, waiting
        // on you again; the rest keep their verdicts
        draft += 1;
        document.querySelector(".review-name")!.textContent = `Landing page, draft ${draft}`;
        document.querySelector("[data-saved]")!.textContent = "draft";
        document.querySelector("[data-waiting]")!.textContent = "An agent is waiting on you";
        document.body.dataset.phase = "reviewing";
        for (const it of toRevise) revise(it, it.verdict!.option!, it.verdict!.note || "no reason given");
        await wait(reduce ? 0 : 650);
        focusItem(items.indexOf(toRevise[0]));
      }
      function agentReply(accepted: number, rejected: string[], undecided: number) {
        if (!accepted) return "Nothing approved, so nothing ships. I'll wait for the next instruction.";
        const parts = [`Publishing the ${accepted} ${accepted === 1 ? "section" : "sections"} you accepted.`];
        if (rejected.length) parts.push(`Leaving out ${rejected.join(", ")}, as you asked.`);
        if (undecided) parts.push(`${undecided} undecided, so those stay out too.`);
        return parts.join(" ");
      }
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

      document.querySelector("[data-restart]")!.addEventListener("click", () => location.reload());

      // Discard: "no, and stop". The whole review ends without a decision.
      const discarded = document.querySelector<HTMLElement>(".discarded")!;
      document.querySelector("[data-discard]")!.addEventListener("click", () => {
        if (document.body.dataset.phase !== "reviewing") return;
        document.body.dataset.phase = "discarded";
        discarded.hidden = false;
        document.querySelector("[data-waiting]")!.textContent = "Discarded · exit 5";
        discarded.querySelector("button")!.focus();
      });
      document.querySelector("[data-undiscard]")!.addEventListener("click", () => {
        document.body.dataset.phase = "reviewing";
        discarded.hidden = true;
        document.querySelector("[data-waiting]")!.textContent = "An agent is waiting on you";
      });

      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "Enter") { e.preventDefault(); handback(); return; }
        const target = e.target as HTMLElement;
        if (document.querySelector("dialog[open]")) return;
        if (target.closest("input, textarea, .decision") || e.metaKey || e.ctrlKey || e.altKey) return;
        if (document.body.dataset.phase !== "reviewing") return;
        const k = e.key.toLowerCase();
        if (k === "j") focusItem(current + 1);
        else if (k === "k") focusItem(current - 1);
        else if (k === "a" && !items[current].verdict) decide(items[current], { action: "accept" });
        else if (k === "r" && !items[current].verdict) { e.preventDefault(); askWhy(items[current]); }
        else return;
      });

      // The waiting clock: how long the agent has been blocked on you.
      const started = Date.now();
      const clock = document.querySelector<HTMLElement>("[data-waiting]")!;
      setInterval(() => {
        if (document.body.dataset.phase !== "reviewing") return;
        const s = Math.floor((Date.now() - started) / 1000);
        if (s >= 5) clock.textContent = `An agent has been waiting ${s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${s % 60}s`}`;
      }, 1000);

      // on a narrow screen the decision is a sheet: start it folded
      if (matchMedia("(max-width: 1180px)").matches) document.querySelector<HTMLDetailsElement>(".decision > details")!.open = false;

      render();
      mark();
    </script>
  </body>
</html>
