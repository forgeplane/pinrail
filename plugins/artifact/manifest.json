{
  "name": "artifact",
  "version": "1.0.0",
  "title": "HTML artifact",
  "description": "An HTML page reviewed element by element: each comment comes back with the element's CSS selector.",
  "use_when": "You designed an HTML page, such as a mockup, a landing page, an email template or a dashboard, and want comments pinned to its elements before you publish it.",
  "attachments": {
    "accept": [".html", ".htm", "text/html"],
    "max_size": 10485760,
    "max_count": 1
  },
  "summary": {
    "outcome": {
      "verdict": {
        "at": "/verdict",
        "values": {
          "approve": { "label": "approved", "tone": "success" },
          "revise": { "label": "changes requested", "tone": "warning" }
        }
      },
      "counts": [
        {
          "items": "/comments",
          "by": "kind",
          "values": {
            "change": { "label": "change", "plural": "changes", "tone": "warning" },
            "question": { "label": "question", "plural": "questions", "tone": "info" },
            "praise": { "label": "praise", "tone": "success" }
          },
          "other": false
        }
      ]
    }
  },
  "shortcuts": [
    { "keys": "s", "does": "Start or stop picking elements" },
    { "keys": "escape", "does": "Stop picking, or close the comment being written" }
  ]
}
