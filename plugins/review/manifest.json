{
  "name": "review",
  "version": 1,
  "title": "Code review",
  "icon": "git-pull-request",
  "payload_schema": { "$ref": "payload.schema.json" },
  "decision_schema": { "$ref": "decision.schema.json" },
  "decision_template": "decision.md.j2",
  "entry": "index.html",
  "min_height": 600,
  "shortcuts": [
    { "keys": "j", "does": "Next proposal", "group": "Move" },
    { "keys": "k", "does": "Previous proposal", "group": "Move" },
    { "keys": "a", "does": "Accept the focused proposal", "group": "Decide" },
    { "keys": "x", "does": "Reject the focused proposal, with a reason", "group": "Decide" },
    { "keys": "e", "does": "Add a note to the focused proposal", "group": "Decide" },
    { "keys": "c", "does": "Comment on the focused proposal's line", "group": "Decide" },
    { "keys": "s", "does": "Review what goes back and hand over", "group": "Decide" },
    { "keys": "v", "does": "Inline or side-by-side diff", "group": "View" },
    { "keys": "o", "does": "Semantic or alphabetical file order", "group": "View" },
    { "keys": "escape", "does": "Close dialogs and composers", "group": "View" }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "diff": {
        "type": "string",
        "title": "Diff",
        "description": "How a file's changes are laid out",
        "oneOf": [{ "const": "inline", "title": "Inline" }, { "const": "split", "title": "Side by side" }],
        "default": "inline"
      },
      "order": {
        "type": "string",
        "title": "File order",
        "description": "The order the agent suggests, or by path; a change without an order is by path",
        "oneOf": [{ "const": "semantic", "title": "Semantic" }, { "const": "path", "title": "By path" }],
        "default": "semantic"
      },
      "findings_only": { "type": "boolean", "title": "Only files with findings", "description": "Hide files the agent had nothing to say about", "default": false },
      "tree_open": { "type": "boolean", "title": "File tree open", "description": "Start with the file tree beside the diff", "default": true }
    }
  }
}
