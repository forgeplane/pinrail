{
  "name": "email",
  "version": "1.0.0",
  "title": "Draft emails",
  "description": "Email drafts read, edited and sent, revised or discarded one by one.",
  "use_when": "You drafted emails on the person's behalf and need them read, edited or approved before anything is sent.",
  "icon": "icon.svg",
  "payload_schema": { "$ref": "schemas/payload.schema.json" },
  "decision_schema": { "$ref": "schemas/decision.schema.json" },
  "example": "example.json",
  "sample": "sample.json",
  "entry": "view/index.html",
  "min_height": 560,
  "shortcuts": [
    { "keys": "j", "does": "Next draft" },
    { "keys": "k", "does": "Previous draft" },
    { "keys": "s", "does": "Send this draft", "group": "Verdicts" },
    { "keys": "r", "does": "Ask for a revision", "group": "Verdicts" },
    { "keys": "x", "does": "Discard this draft", "group": "Verdicts" },
    { "keys": "shift+s", "does": "Send every draft still undecided", "group": "Verdicts" },
    { "keys": "e", "does": "Put the cursor in the message" }
  ]
}
