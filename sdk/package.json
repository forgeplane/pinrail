{
  "name": "pinrail-sdk",
  "version": "1.0.0",
  "description": "Write and test a pinrail plugin: the SDK the app serves, a shell to develop a view in the browser, and a Playwright harness to test it alone",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgeplane/pinrail.git",
    "directory": "sdk"
  },
  "type": "module",
  "bin": {
    "pinrail-sdk": "bin/pinrail-sdk.mjs"
  },
  "exports": {
    "./testing": {
      "types": "./testing/index.d.cts",
      "default": "./testing/index.cjs"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./host": {
      "types": "./host/host.d.ts",
      "default": "./host/host.js"
    },
    "./sdk/v1/pinrail-plugin.js": "./src/pinrail-plugin.js",
    "./sdk/v1/markdown.js": "./dist/markdown.js",
    "./package.json": "./package.json",
    "./schemas/manifest.schema.json": "./schemas/manifest.schema.json",
    "./schemas/attachment.schema.json": "./schemas/attachment.schema.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "bin",
    "dist",
    "host",
    "lib",
    "shell",
    "src",
    "testing",
    "types.d.ts",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs test/*.test.mjs && playwright test",
    "prepack": "node scripts/build-markdown.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ajv": "^8.20.0",
    "markdown-it": "^15.0.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
