    "html": "<!doctype html><html><head><style>\n*{box-sizing:border-box;margin:0}body{font-family:Inter,system-ui,sans-serif;color:#0f172a;background:#fff}\n.nav{display:flex;align-items:center;justify-content:space-between;padding:20px 56px;border-bottom:1px solid #e2e8f0}\n.logo{font-weight:800;font-size:20px;letter-spacing:-.02em}.logo span{color:#0ea5e9}\n.nav a{color:#475569;text-decoration:none;margin-left:28px;font-size:14px}.nav .cta{background:#0f172a;color:#fff;padding:9px 16px;border-radius:8px}\n#hero{padding:88px 56px 64px;display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center}\n#hero h1{font-size:54px;line-height:1.05;letter-spacing:-.035em}#hero p{margin:20px 0 28px;font-size:19px;line-height:1.6;color:#475569}\n.btns a{display:inline-block;padding:13px 22px;border-radius:10px;font-weight:600;text-decoration:none;margin-right:10px}\n.primary{background:#0ea5e9;color:#fff}.ghost{border:1px solid #cbd5e1;color:#0f172a}\n.code{background:#0b1220;color:#cbd5e1;border-radius:14px;padding:22px;font:13px/1.7 ui-monospace,Menlo,monospace;box-shadow:0 30px 60px -30px rgba(2,6,23,.6)}\n.code b{color:#7dd3fc;font-weight:400}.code i{color:#86efac;font-style:normal}\n#features{padding:40px 56px 80px;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n.card{border:1px solid #e2e8f0;border-radius:14px;padding:24px}.card h3{font-size:17px;margin-bottom:8px}.card p{color:#64748b;font-size:14.5px;line-height:1.6}\n#pricing{padding:0 56px 90px;text-align:center}#pricing h2{font-size:34px;letter-spacing:-.02em;margin-bottom:8px}#pricing .price{font-size:48px;font-weight:800;margin:18px 0 4px}\n</style></head><body>\n<div class=\"nav\"><div class=\"logo\">tide<span>water</span></div><div><a href=\"#\">Docs</a><a href=\"#\">Pricing</a><a href=\"#\">Status</a><a class=\"cta\" href=\"#\">Get an API key</a></div></div>\n<section id=\"hero\"><div><h1>Shipping rates from 40 carriers, in one call.</h1><p>Tidewater compares live rates, transit times and surcharges across carriers so your checkout shows the right price the first time.</p><div class=\"btns\"><a class=\"primary\" href=\"#\">Start for free</a><a class=\"ghost\" href=\"#\">Read the docs</a></div></div>\n<div class=\"code\"><b>POST</b> /v2/rates<br>{<br>&nbsp;&nbsp;\"from\": \"Rotterdam, NL\",<br>&nbsp;&nbsp;\"to\": \"Austin, TX\",<br>&nbsp;&nbsp;\"parcel\": { \"kg\": 2.4 }<br>}<br><br><i>// 38 quotes in 212 ms</i></div></section>\n<section id=\"features\"><div class=\"card\"><h3>Every carrier, one schema</h3><p>DHL, UPS, FedEx and 37 regional carriers, normalized into one response.</p></div><div class=\"card\"><h3>Surcharges included</h3><p>Fuel, residential and remote-area fees are priced in, not discovered on the invoice.</p></div><div class=\"card\"><h3>Built for checkout</h3><p>P95 under 300 ms, with cached fallbacks when a carrier is slow.</p></div></section>\n<section id=\"pricing\"><h2>Simple pricing</h2><p style=\"color:#64748b\">Pay for the quotes you request. No minimums.</p><div class=\"price\">$0.002</div><p style=\"color:#64748b\">per rate request after 10,000 free each month</p></section>\n</body></html>"
