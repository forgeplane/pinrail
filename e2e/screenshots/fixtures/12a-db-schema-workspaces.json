    "questions": [
      {
        "id": "q1",
        "text": "Should the role be a Postgres `enum` type instead of `text` with a check constraint? An enum is stricter, but adding a role later needs `ALTER TYPE`.",
        "about": {
          "table": "memberships",
          "column": "role"
        },
        "options": [
          "text with a check constraint",
          "enum type"
        ],
        "proposal": "text with a check constraint"
      },
      {
        "id": "q2",
        "text": "When a member leaves a workspace, what should happen to the tasks assigned to them there?",
        "about": {
          "relationship": "tasks_assignee_id_fkey"
        },
        "options": [
          "Leave them assigned",
          "Unassign them"
