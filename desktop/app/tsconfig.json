{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "pinrail-sdk/host": ["../../pinrail-plugin/host/host.d.ts"],
      "pinrail-sdk/types": ["../../pinrail-plugin/types.d.ts"]
    }
  },
  "include": ["ui/src"]
}
