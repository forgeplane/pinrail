{
  "name": "wicket-plugin",
  "version": "1.8.0",
  "description": "Write and test a wicket plugin: the SDK the app serves, a shell to develop a view in the browser, and a Playwright harness to test it alone",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgeplane/wicket.git",
    "directory": "wicket-plugin"
  },
  "type": "module",
  "bin": {
    "wicket-plugin": "bin/wicket-plugin.mjs"
  },
  "exports": {
    "./testing": {
      "types": "./harness/index.d.cts",
      "default": "./harness/index.cjs"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./sdk/v1/wicket-plugin.js": "./src/wicket-plugin.js",
    "./sdk/v1/wicket-plugin.css": "./src/wicket-plugin.css",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "bin",
    "harness",
    "lib",
    "licenses",
    "shell",
    "src",
    "templates",
    "types.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs && playwright test"
  },
  "dependencies": {
    "lucide-static": "1.45.0",
    "markdown-it": "^15.0.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
